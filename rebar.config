%% -*- mode: erlang -*-
%% rebar3 configuration for hecate-rag (realm service daemon)

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% Service substrate
    {hecate_om, "~> 0.17"},

    % NOT declaring evoq/reckon_db/reckon_evoq/reckon_gater here: hecate_om
    % declares them and wires the store, and this service no longer
    % references any of them directly (ingest/embed/prune write straight to
    % barrel — see barrel below). Re-declaring a substrate dep a service
    % doesn't use itself is exactly how these drifted three majors behind
    % once before; let hecate_om be the one source of truth for its own
    % substrate versions.

    %% Local HTTP (admin / health)
    %% Pinned at 2.12.0 transitively by hecate_om's OWN rebar.config (its
    %% cowboy dep is "~> 2.12.0", not loosened even at hecate_om 0.16.4) --
    %% asking for a newer cowboy here deadlocks rebar3's resolver
    %% (cowlib version mismatch). Hex latest is 2.18.0; this can't move
    %% until hecate_om's own pin does. Not fixed here -- that's a change to
    %% a different, foundational repo, out of scope for this pass.
    {cowboy, "~> 2.12.0"},

    %% Document + vector storage, with an embedding policy keeping the two
    %% in sync automatically ("record mode") — replaces the hand-rolled
    %% esqlite (chunks/sources tables) + hecate_vector (brute-force ANN
    %% scaffold, no persistence) + hecate_embed (separate embed calls)
    %% combination. From hex, not the beam-campus/barrel fork's git tree:
    %% barrel-db/barrel is a rebar3 umbrella (each app in its own apps/*
    %% subdir), and rebar3 has no support for depending on a single app
    %% from a git monorepo subdirectory (upstream issue #1923, still open;
    %% the author's own intended distribution path is hex). The fork has
    %% zero commits diverging from upstream right now, so this is
    %% identical to depending on the fork today; once the fork carries
    %% real patches, bump this pin once they're released.
    {barrel, "~> 1.3"},

    {macula_rag, {git, "https://github.com/macula-io/macula-rag.git", {branch, "main"}}}
]}.

%% NOTE: rustler / rebar3_cargo intentionally NOT declared as deps, same
%% reasoning hecate_vector/hecate_embed already document -- rustler 0.34
%% pulls in Elixir-side hex transitives rebar3 can't compile without a mix
%% builder, and the NIF's Erlang side (hecate_rag_corpus_sync_nif.erl) only
%% needs `on_load` + `erlang:nif_error/1` stubs, no rustler on the BEAM
%% code path.
%%
%% To actually BUILD the corpus-sync NIF .so, run
%% scripts/build-corpus-sync-nif.sh (invokes cargo directly against
%% native/hecate_rag_corpus_sync_nif). The Rust crate uses `rustler` +
%% `git2` (vendored libgit2) from crates.io; those are Rust deps, not hex
%% deps -- no rebar3 involvement.

{relx, [
    {release, {hecate_rag, "0.1.8"}, [
        hecate_rag,

        hecate_om,

        reckon_db,
        evoq,
        reckon_evoq,

        rag,

        embed_corpus,
        refresh_corpus,
        serve_retrieval,

        query_chunks,
        query_sources,

        barrel,
        macula_rag
    ]},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [hecate_rag]}
]}.

{profiles, [
    {test, [
        {deps, [{meck, "0.9.2"}]}
    ]},
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true}
        ]}
    ]}
]}.

{project_plugins, [rebar3_lint]}.

%% Elvis: the org's structural ruleset, matching the sibling services. No
%% deep nesting (HARD, one level), no nested try/catch, no if. Run via
%% plain `rebar3 lint` -- `project_plugins' makes it available without a
%% profile, same as every other hecate-services repo.
{elvis, [
    {rulesets, #{
        hecate_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [ #{files => ["src/**/*.erl", "apps/*/src/**/*.erl"],
                 ruleset => hecate_min} ]}
]}.
