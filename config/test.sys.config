%% sys.config for `rebar3 ct`.
%%
%% `rebar3 ct' does NOT auto-apply `config/sys.config' (that's only
%% wired for `rebar3 shell', via the top-level `{shell, [{config, ...}]}'
%% in rebar.config) — pass this file explicitly:
%%
%%   rebar3 ct --sys_config config/test.sys.config
%%
%% Ports are 18470/18471, not 8470/8470: a dev instance of hecate-rag may
%% already be running on this box (e.g. the `hecate-rag-dev.service`
%% systemd unit) and binding the same port crashes `hecate_om`'s health
%% listener before any test gets a chance to run.
%%
%% `data_dir' is a repo-local path a developer's own account can write,
%% not the container-only `/var/lib/hecate-rag'.

[
    {hecate_rag, [
        {http_port,   18470},
        {data_dir,    "_build/test/hecate-rag-data"},
        {embed_url,   <<"http://127.0.0.1:11434">>},
        {embed_model, <<"nomic-embed-text">>},
        {embed_dim,   768}
    ]},

    {hecate_om, [
        {service_cert_path, "/etc/hecate/secrets/service-cert.pem"},
        {station_socket,    "/run/macula/station.sock"},
        {health_port,       18471}
    ]}
].
