%% Dev/local sys.config — runs on the laptop, no realm, no station.

[
    {hecate_rag, [
        {http_port,   8470},
        {data_dir,    "/home/rl/.hecate/hecate-rag/data"},
        {embed_url,   <<"http://127.0.0.1:11434">>},
        {embed_model, <<"nomic-embed-text">>},
        {embed_dim,   768},
        {topic_classifier, #{
            enabled  => true,
            api_key  => <<"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">>,
            endpoint => <<"https://integrate.api.nvidia.com/v1/chat/completions">>,
            model    => <<"minimaxai/minimax-m3">>,
            timeout  => 30000
        }}
    ]},

    {hecate_om, [
        {service_cert_path, "/home/rl/.hecate/hecate-rag/service-cert.pem"},
        {station_socket,    "/home/rl/.hecate/hecate-rag/station.sock"},
        {health_port,       8471}
    ]}
].
