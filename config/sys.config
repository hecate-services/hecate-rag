%% Dev/local sys.config for hecate-rag.
%%
%% Defaults are tuned for a *no-realm, no-station* local-dev run:
%%   - Embedder: Ollama HTTP, nomic-embed-text (768-dim) on localhost
%%   - Storage: ~/.hecate/hecate-rag or /var/lib/hecate-rag inside container
%%   - HTTP: loopback on 8470
%%
%% For production (BEAM cluster, realm-bound), override via
%% hecate-gitops env-files (each entry below maps to a typical
%% RELX_OVERLAY_*-style env var or a separate config layer).

[
    {hecate_rag, [
        {http_port,   8470},
        {data_dir,    "/var/lib/hecate-rag/data"},
        {index_dir,   "/var/lib/hecate-rag/index"},
        {event_store_id, rag_store}
    ]},

    {hecate_om, [
        {service_cert_path, "/etc/hecate/secrets/service-cert.pem"},
        {station_socket,    "/run/macula/station.sock"},
        {health_port,       8470}
    ]},

    {hecate_embed, [
        {backend,          ollama},
        {default_model_id, <<"nomic-embed-text">>},
        {default_dim,      768},
        {ollama_url,       "http://127.0.0.1:11434/api/embeddings"}
    ]}
].
